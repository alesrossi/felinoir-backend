{
  // Serilog: levels, overrides, enrichers and sinks. Adding a "WriteTo" here replaces the default
  // console sink (ECS JSON, or readable lines in Development).
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
