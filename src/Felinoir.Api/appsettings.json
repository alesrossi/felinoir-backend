{
  // Serilog: levels, overrides, enrichers and sinks. Adding a "WriteTo" here replaces the default
  // outputs (LogOutputs: readable console lines; LOG_CONSOLE_FORMAT=ecs for ECS JSON; LOG_FILE_PATH
  // for rolling ECS JSON files).
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
