# Copy to server/.env on the server (next to docker-compose.yml); docker compose reads it.
# Every service is interpolated from this file, including `docker compose run cinema-scraper`
# in daily-report.sh, so a required variable missing here stops all of them.

# ── Backend and scraper ───────────────────────────────────────────────────────
# Google Gemini: Felix (backend) and the AI match verification (scraper's enrich:ai).
GEMINI_API_KEY=
# TMDB: the scraper's enrichment (the backend never reads it).
TMDB_READ_ACCESS_TOKEN=
# OMDb: the scraper's enrich:omdb.
OMDB_API_KEY=
# Optional scraper proxy.
USE_PROXY=false
PROXY_URL=

# ── Logs (Grafana at https://logs.felinoir.it) ─────────────────────────────────
# Grafana's login. Required: Grafana won't start without a password. Used only on the first
# start; later changes go through Grafana (or `docker exec grafana grafana cli admin
# reset-admin-password <new>`).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Most disk Loki may use, in MB (default 5120 = 5 GB); logs also expire after 31 days.
LOG_RETENTION_MAX_MB=5120
