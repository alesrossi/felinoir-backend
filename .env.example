# Copy to .env for local dev and IDE runs (.env is gitignored).
# Integration tests ignore this file — they use an ephemeral Testcontainers Postgres.

# Postgres connection. URI form is accepted and converted to Npgsql keyword form
# automatically (see Felinoir.Infrastructure/Configuration/DatabaseUrl).
DATABASE_URL=postgres://user:password@localhost:5432/felinoir?sslmode=disable

# Google Gemini API key — required for the Felix chat endpoint (/felix/chat).
GEMINI_API_KEY=

# HTTP port. Optional, defaults to 3001.
# PORT=3001

# Logging. Optional. The console prints readable lines; LOG_CONSOLE_FORMAT=ecs prints Elastic
# Common Schema JSON instead. LOG_FILE_PATH also writes ECS JSON to rolling files (daily and at
# 100 MB, at most a month / 5 GB kept); the date is inserted before the extension.
# LOG_CONSOLE_FORMAT=ecs
# LOG_FILE_PATH=logs/felinoir-api-.json
