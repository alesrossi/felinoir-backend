root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,xml,json,yml,yaml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = when_multiline:silent
dotnet_style_qualification_for_field = false:silent

# EF Core migrations are generated by `dotnet ef`; analysers don't apply to them.
[**/Migrations/*.cs]
generated_code = true

# Verify snapshots are compared byte for byte.
[*.verified.*]
insert_final_newline = false
trim_trailing_whitespace = false

# Tests: underscored names are the naming convention, inline arrays read better in assertions,
# and xUnit names collection definitions "...Collection".
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1711.severity = none

[*.cs]
# CA1716 protects Visual Basic callers from names like Error; this solution is C# only.
dotnet_diagnostic.CA1716.severity = none
